# Telegram Bot Token (получить от @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin user ID (для админ команд, опционально)
ADMIN_ID=your_telegram_id

# Белый список ID чатов/групп/каналов, где бот будет работать
# Можно перечислять через запятую: 123456789,-1001234567890,-1009876543210
# Если оставить пустым, бот будет работать везде
ALLOWED_CHAT_IDS=

# Максимальный размер файла в МБ (Telegram лимит 50 МБ для ботов)
MAX_FILE_SIZE_MB=50

# Время жизни временных файлов в минутах
FILE_CLEANUP_INTERVAL=10

# База данных
DATABASE_PATH=data/bot.db

# Папка для скачивания
DOWNLOADS_PATH=downloads
